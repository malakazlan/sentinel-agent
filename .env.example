# .env.example — Sentinel
# Copy this file to `.env` (which is gitignored) and fill in values.
# Never commit `.env` — secrets stay local or in GCP Secret Manager.

# ─────────────────────────────────────────────────────────────────────
# Google Cloud / Gemini
# ─────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
# Use `global` for Gemini 3.x model family (ADR-010); `us-central1` is
# sufficient for Gemini 2.5 and older.
GOOGLE_CLOUD_LOCATION=global

# Toggle the ADK / google-genai client between Vertex AI (recommended for
# this project — GCP-native, judged signal) and AI Studio.
#   true  → use Vertex AI on GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION
#   false → use AI Studio with GOOGLE_API_KEY below
GOOGLE_GENAI_USE_VERTEXAI=true

# ── Auth: pick ONE path below ────────────────────────────────────────
#
# (1) Application Default Credentials — recommended for local dev.
#     Run `gcloud auth application-default login` once and leave the
#     two variables below blank.
#
# (2) Service-account key — recommended for CI and Cloud Run.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# (3) AI Studio API key — only valid when GOOGLE_GENAI_USE_VERTEXAI=false.
# GOOGLE_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Phoenix (self-hosted — see ADR-003)
# ─────────────────────────────────────────────────────────────────────
# We run Phoenix locally for the entire dev cycle. NO Phoenix Cloud key
# here — Phoenix Cloud is geo-blocked and explicitly out of scope.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=sentinel

# ─────────────────────────────────────────────────────────────────────
# Streamlit UI
# ─────────────────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ─────────────────────────────────────────────────────────────────────
# Slack MCP (Phase 7 / ADR-015 reversed — SlackAnnouncerAgent)
# ─────────────────────────────────────────────────────────────────────
# Enable Slack announcements at incident lifecycle boundaries (started,
# postmortem_validated, failed). Default off so CI + dev don't try to
# post to a workspace that isn't configured.
# SENTINEL_SLACK_ENABLED=0
#
# Slack bot token (xoxb-...) and team ID — required by the Slack MCP
# server when SENTINEL_SLACK_ENABLED=1.
# SLACK_BOT_TOKEN=
# SLACK_TEAM_ID=
#
# Channel ID Sentinel posts incident announcements into.
# SENTINEL_SLACK_CHANNEL_ID=
#
# Optional human-acknowledgment gate (not enabled by default — see
# ADR-015 for the design). When set to 1, the orchestrator waits for
# a :+1: reaction on the postmortem draft before finalizing.
# SENTINEL_SLACK_ACK_GATE=0
# SENTINEL_SLACK_ACK_TIMEOUT_S=300

# ─────────────────────────────────────────────────────────────────────
# GitHub MCP (Phase 7 / ADR-014 — DeployCorrelatorAgent)
# ─────────────────────────────────────────────────────────────────────
# Personal access token with at least `repo:read` scope on the watched
# repository. Without this set, DeployCorrelator's GitHub tools fail with
# 401 at call time (intentional — never silent).
# GITHUB_PERSONAL_ACCESS_TOKEN=
#
# Default repository the DeployCorrelator queries when the alert payload
# doesn't include one. Format: owner/repo (e.g. acme/fraud-detector).
# SENTINEL_GITHUB_REPO=

# ─────────────────────────────────────────────────────────────────────
# Incident memory store (Phase 7 / ADR-013)
# ─────────────────────────────────────────────────────────────────────
# Choose the backend:
#   local         (default) JSONL + cosine in-process. Zero infra cost.
#                 Suitable for dev + offline demos.
#   vector_search Vertex AI Vector Search + local sidecar. Run
#                 `scripts/setup_vector_search.py` once to provision the
#                 index + endpoint. The endpoint costs ~$0.45/hour while
#                 deployed; undeploy when not actively demoing.
SENTINEL_MEMORY_BACKEND=local
#
# Optional override for the local JSONL memory store location. Defaults
# to data/memory/incidents.jsonl (gitignored).
# SENTINEL_MEMORY_STORE_PATH=
#
# Optional override for the Vector Search config emitted by the setup
# script. Defaults to data/memory/vector_search_config.json (gitignored).
# SENTINEL_VECTOR_SEARCH_CONFIG=
#
# Optional Vector Search index display name override (defaults to
# `sentinel-incident-memory`).
# SENTINEL_VECTOR_INDEX_NAME=

# ─────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR — use DEBUG during agent development,
# INFO once the system is stable.
LOG_LEVEL=INFO
